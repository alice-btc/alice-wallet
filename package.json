{
  "name": "alice-wallet",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bash scripts/run-tests.sh",
    "check:types": "tsc --noEmit --incremental false -p apps/wallet-mobile/tsconfig.json",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:npm-audit": "node scripts/check-npm-audit.mjs",
    "build:curated-rag": "node scripts/build-curated-rag.mjs",
    "check:curated-rag": "node scripts/build-curated-rag.mjs --check"
  },
  "overrides": {
    "@expo/cli": {
      "tar": "7.5.22"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    },
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    },
    "postcss": "8.5.28",
    "ws@>=8 <9": "8.22.0",
    "@satora/swap": {
      "viem": {
        "ws": "8.22.0"
      }
    },
    "metro": "0.83.8",
    "metro-babel-transformer": "0.83.8",
    "metro-cache": "0.83.8",
    "metro-cache-key": "0.83.8",
    "metro-config": "0.83.8",
    "metro-core": "0.83.8",
    "metro-file-map": "0.83.8",
    "metro-minify-terser": "0.83.8",
    "metro-resolver": "0.83.8",
    "metro-runtime": "0.83.8",
    "metro-source-map": "0.83.8",
    "metro-symbolicate": "0.83.8",
    "metro-transform-plugins": "0.83.8",
    "metro-transform-worker": "0.83.8"
  },
  "allowScripts": {
    "llama.rn@0.12.5": true
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "tar": "^7.5.22"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
